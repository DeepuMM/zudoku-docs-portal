        <mxCell id="gov1" value="&lt;b&gt;Ownership&lt;/b&gt;&lt;br&gt;Each PortCo owns its repo, pipeline and folder. Its CODEOWNERS approve content. DataX owns the preset, the landing page and the hosting." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1F2937;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="70" y="830" width="370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gov2" value="&lt;b&gt;Consistency&lt;/b&gt;&lt;br&gt;Every site pins @datax/docs-preset. A new preset release (e.g. a new PortCo in the top bar) must be adopted within the agreed deadline." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1F2937;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="460" y="830" width="370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gov3" value="&lt;b&gt;Quality gate&lt;/b&gt;&lt;br&gt;A pull request must build and pass the link check before merge. Merge to main publishes; the previous build stays in blob versioning for rollback." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1F2937;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="850" y="830" width="370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gov4" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;No stored secrets. Private endpoint only. Anyone who can reach the site can read every section; restricted content needs its own hosting." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1F2937;verticalAlign=top;" vertex="1" parent="1">
